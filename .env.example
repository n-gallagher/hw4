# Copy to .env and fill in real values. Never commit .env.
# (The backend also reads ../.env, the parent folder, if a key isn't set here.)

# Signs login session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# AI model for the shop agent. "anthropic" (default) or "portkey".
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high (blank = model default). Default effort was chosen in COST_CHECK_REPORT.md.
ANTHROPIC_EFFORT=

# Only needed if MODEL_PROVIDER=portkey (OpenAI 5.6 / 6 series models through Portkey)
PORTKEY_API_KEY=your_portkey_api_key_here
OPENAI_MODEL=gpt-5.6-luna
